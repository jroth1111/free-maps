{
  "name": "free-maps",
  "version": "0.3.0",
  "description": "Framework-neutral MapLibre explorer components with Cloudflare PMTiles helpers",
  "type": "module",
  "license": "MIT",
  "author": "Jacob Roth",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jroth1111/free-maps.git"
  },
  "homepage": "https://free-maps.forkandflag.com",
  "bugs": "https://github.com/jroth1111/free-maps/issues",
  "keywords": [
    "maplibre",
    "pmtiles",
    "protomaps",
    "openstreetmap",
    "web-component",
    "cloudflare"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "exports": {
    "./core": {
      "types": "./dist/core.d.ts",
      "import": "./dist/core.js"
    },
    "./element": {
      "types": "./dist/element.d.ts",
      "import": "./dist/element.js"
    },
    "./maplibre": {
      "types": "./dist/maplibre.d.ts",
      "import": "./dist/maplibre.js"
    },
    "./vector": {
      "types": "./dist/vector.d.ts",
      "import": "./dist/vector.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js"
    },
    "./cloudflare": {
      "types": "./dist/cloudflare.d.ts",
      "import": "./dist/cloudflare.js"
    },
    "./themes/atlas.css": "./dist/themes/atlas.css",
    "./themes/atlas-dark.css": "./dist/themes/atlas-dark.css",
    "./package.json": "./package.json"
  },
  "peerDependencies": {
    "maplibre-gl": ">=5.7.1 <6",
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "maplibre-gl": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "dependencies": {
    "@mapbox/vector-tile": "^2.0.5",
    "lit": "^3.3.1",
    "pbf": "^4.0.2",
    "pmtiles": "^4.3.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@cloudflare/vitest-pool-workers": "^0.18.6",
    "@cloudflare/workers-types": "^5.20260718.1",
    "@fontsource-variable/hanken-grotesk": "^5.2.8",
    "@fontsource-variable/literata": "^5.2.8",
    "@playwright/test": "^1.55.0",
    "@protomaps/basemaps": "^5.6.0",
    "@puppeteer/browsers": "2.10.10",
    "@testing-library/dom": "^10.4.1",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^22.17.0",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^4.7.0",
    "eslint": "^9.34.0",
    "eslint-plugin-lit": "^2.1.1",
    "jsdom": "^26.1.0",
    "license-checker-rseidelsohn": "^4.4.2",
    "lighthouse": "13.4.0",
    "maplibre-gl": "5.24.0",
    "node-addon-api": "^8.5.0",
    "node-gyp": "^11.4.2",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "tsup": "^8.5.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.64.0",
    "vite": "^7.1.3",
    "vitest": "^4.1.0",
    "wrangler": "^4.112.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "preview:test": "npm run build && wrangler dev --port 4173 --var TILE_SESSION_SECRET:test-only-not-production --var PRODUCTION_ORIGIN:http://localhost:4173",
    "build": "npm run clean && npm run assets:generate && tsup && node scripts/copy-package-assets.mjs && vite build",
    "clean": "node scripts/clean.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run --config vitest.config.ts",
    "test:worker": "vitest run --config vitest.worker.config.ts",
    "test:e2e": "playwright test",
    "lighthouse:matrix": "node scripts/run-lighthouse-matrix.mjs",
    "cache:verify": "node scripts/verify-cache.mjs",
    "test:all": "npm run lint && npm run typecheck && npm run test && npm run test:worker && npm run build && npm run check:budgets && npm run check:boundaries && npm run check:forbidden && npm run package:verify",
    "package:pack": "npm pack --pack-destination artifacts",
    "package:verify": "node scripts/verify-package.mjs",
    "check:forbidden": "node scripts/check-forbidden.mjs",
    "check:budgets": "node scripts/check-budgets.mjs",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "check:secrets": "node scripts/check-secrets.mjs",
    "check:licenses": "license-checker-rseidelsohn --production --summary",
    "check:dependencies": "npm audit --omit=dev --audit-level=high",
    "assets:sync": "node scripts/sync-map-assets.mjs && npm run assets:generate",
    "assets:generate": "node scripts/generate-map-assets.mjs",
    "deploy": "node scripts/deploy.mjs",
    "cf:types": "wrangler types",
    "basemap:extract": "node scripts/extract-basemap.mjs",
    "basemap:verify": "node scripts/verify-basemap.mjs",
    "basemap:upload": "npx wrangler r2 object put free-maps-basemap/basemaps/greater-melbourne-20260717.pmtiles --file=basemap/greater-melbourne-20260717.pmtiles --content-type=application/vnd.pmtiles --cache-control='public, max-age=31536000, immutable' --remote"
  }
}
